# Firebase Client SDK (Next.js Public)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-kickpro.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-kickpro
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-kickpro.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:kickprodemo
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_REGION=asia-southeast2

# Local Emulator toggle (true saat development lokal)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_ENABLE_DESIGN_PAGE=true

# Firebase Admin SDK (untuk staging/prod; kosongkan saat memakai Emulator)
FIREBASE_PROJECT_ID=demo-kickpro
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Sentry Monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
