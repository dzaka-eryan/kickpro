rules_version = '2';

// =============================================================================
// KickPro — Firestore Security Rules (Baseline)
// =============================================================================
// Prinsip:
// 1. Deny-by-default.
// 2. Client membaca langsung (sesuai hak akses), namun semua operasi sensitif
//    (slot status, pembayaran, walletBalance, escrowBalance, ledger, status
//    sparring) hanya dapat ditulis oleh Cloud Functions via Firebase Admin SDK.
//
// Assumed Data Model (ringkasan koleksi):
// - users/{userId}: name, phoneNumber, photoUrl, city, geo, position,
//     preferredFoot, favoriteNumber, attendanceScore (0-100), stats,
//     platformRole ("user"|"superadmin"), fcmTokens, createdAt
// - clubs/{clubId}: name, slug, logoUrl, city, geo, description, vision,
//     sportTypes, level, avgAge, walletBalance, escrowBalance,
//     totalMatchesPlayed, fairPlayScore, fairPlayCount, subscription,
//     pgSubAccountId, createdAt
//   - clubs/{clubId}/members/{memberId}: userId, role, status, joinedAt
//   - clubs/{clubId}/ledger/{entryId}: immutable financial ledger
//   - clubs/{clubId}/payouts/{payoutId}: payout requests & disbursement state
//   - clubs/{clubId}/joinRequests/{userId}: userId, message, status, createdAt
//   - clubs/{clubId}/gallery/{photoId}: imageUrl, caption, uploadedBy, createdAt
// - events/{eventId}: clubId, title, sportType, level, venueName, venueAddress,
//     venueGeo, bookingProofUrl, startAt, endAt, eventDate, startTime, endTime,
//     teamCount, playersPerTeam, totalSlots, pricePerSlot, platformFee,
//     filledSlots, lockedSlots, status, cancellationPolicy, createdAt
//   - events/{eventId}/teams/{teamId}: name, color, index
//   - events/{eventId}/slots/{slotId}: slotNumber, teamId, position, status,
//       lockedByUserId, lockExpiresAt, userId, playerName, playerPhone,
//       paymentId, ticketCode, checkedInAt
// - payments/{paymentId}: type, userId, clubId, refPath, amount, platformFee,
//     grossAmount, pgProvider, pgInvoiceId, pgStatus, method, status,
//     idempotencyKey, paidAt, createdAt
// - sparring_matches/{matchId} + challenges/{clubId}, proposals/{proposalId}, ratings/{clubId}
// - notifications/{userId}/items/{itemId}: type, title, body, isRead, readAt, createdAt
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.platformRole == 'superadmin';
    }

    function memberPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
    }

    function isClubMember(clubId) {
      return isSignedIn() &&
        exists(memberPath(clubId)) &&
        get(memberPath(clubId)).data.status == 'active';
    }

    function isClubRole(clubId, roles) {
      return isClubMember(clubId) &&
        get(memberPath(clubId)).data.role in roles;
    }

    function isValidUserCreate(userId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'name',
          'phoneNumber',
          'city',
          'position',
          'preferredFoot',
          'attendanceScore',
          'platformRole',
          'createdAt'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.phoneNumber is string && data.phoneNumber.matches('^\\+62[0-9]{8,13}$') &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
        data.position in ['GK', 'DF', 'MF', 'FW'] &&
        data.preferredFoot in ['left', 'right', 'both'] &&
        data.attendanceScore == 100 &&
        data.platformRole == 'user' &&
        (!('id' in data) || data.id == userId);
    }

    function isValidUserUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return !changed.hasAny([
          'attendanceScore',
          'stats',
          'platformRole',
          'createdAt'
        ]) &&
        changed.hasOnly([
          'name',
          'phoneNumber',
          'photoUrl',
          'city',
          'geo',
          'position',
          'preferredFoot',
          'favoriteNumber',
          'fcmTokens'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
        data.position in ['GK', 'DF', 'MF', 'FW'] &&
        data.preferredFoot in ['left', 'right', 'both'];
    }

    function isValidClubUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return !changed.hasAny([
          'walletBalance',
          'escrowBalance',
          'totalMatchesPlayed',
          'fairPlayScore',
          'fairPlayCount',
          'subscription',
          'pgSubAccountId',
          'slug',
          'createdAt'
        ]) &&
        changed.hasOnly([
          'name',
          'logoUrl',
          'city',
          'geo',
          'description',
          'vision',
          'sportTypes',
          'level',
          'avgAge'
        ]) &&
        data.name is string && data.name.size() >= 3 && data.name.size() <= 80 &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 80;
    }

    function isValidEventClientUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return !changed.hasAny([
          'clubId',
          'pricePerSlot',
          'platformFee',
          'totalSlots',
          'filledSlots',
          'lockedSlots',
          'status',
          'teamCount',
          'playersPerTeam',
          'createdAt'
        ]) &&
        changed.hasOnly([
          'title',
          'level',
          'venueName',
          'venueAddress',
          'venueGeo',
          'bookingProofUrl',
          'cancellationPolicy'
        ]) &&
        data.title is string && data.title.size() >= 5 && data.title.size() <= 120;
    }

    // -------------------------------------------------------------------------
    // users/{userId}
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUserCreate(userId);
      allow update: if isOwner(userId) && isValidUserUpdate();
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // clubs/{clubId} & subcollections
    // -------------------------------------------------------------------------
    match /clubs/{clubId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if isClubRole(clubId, ['head_admin']) && isValidClubUpdate();

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      match /ledger/{entryId} {
        allow read: if isClubMember(clubId) || isSuperAdmin();
        allow write: if false;
      }

      match /payouts/{payoutId} {
        allow read: if isClubRole(clubId, ['head_admin', 'treasurer']) || isSuperAdmin();
        allow write: if false;
      }

      match /joinRequests/{userId} {
        allow read: if isOwner(userId) || isClubRole(clubId, ['head_admin', 'event_host']);
        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasAll(['userId', 'message', 'status', 'createdAt']) &&
          request.resource.data.userId == userId &&
          request.resource.data.status == 'pending' &&
          request.resource.data.message is string &&
          request.resource.data.message.size() <= 300;
        allow update, delete: if false;
      }

      match /gallery/{photoId} {
        allow read: if true;
        allow create: if isClubRole(clubId, ['head_admin', 'event_host']) &&
          request.resource.data.keys().hasAll(['imageUrl', 'caption', 'uploadedBy', 'createdAt']) &&
          request.resource.data.uploadedBy == request.auth.uid;
        allow delete: if isClubRole(clubId, ['head_admin', 'event_host']);
        allow update: if false;
      }
    }

    // -------------------------------------------------------------------------
    // events/{eventId}, teams/{teamId}, slots/{slotId}
    // -------------------------------------------------------------------------
    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if isClubRole(resource.data.clubId, ['head_admin', 'event_host']) &&
        isValidEventClientUpdate();

      match /teams/{teamId} {
        allow read: if true;
        allow write: if false;
      }

      match /slots/{slotId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Collection group query read support for authenticated users (My Tickets & Riwayat Mabar)
    match /{path=**}/slots/{slotId} {
      allow read: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // payments/{paymentId}
    // -------------------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // sparring_matches/{matchId} & subcollections
    // -------------------------------------------------------------------------
    match /sparring_matches/{matchId} {
      allow read: if true;
      allow write: if false;

      match /challenges/{clubId} {
        allow read: if true;
        allow write: if false;
      }

      match /proposals/{proposalId} {
        allow read: if true;
        allow write: if false;
      }

      match /ratings/{clubId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // notifications/{userId}/items/{itemId}
    // -------------------------------------------------------------------------
    match /notifications/{userId}/items/{itemId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']) &&
        request.resource.data.isRead is bool;
      allow create, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Deny by default for everything else
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
